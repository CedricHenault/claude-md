{
  "model": "claude-opus-5",
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "supabase@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "stripe@claude-plugins-official": true,
    "remember@claude-plugins-official": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "claude-code-skills": {
      "source": {
        "source": "github",
        "repo": "alirezarezvani/claude-skills"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    }
  },
  "theme": "dark",
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(cat *.env:*) in backend/ or frontend/ — reading/printing local env files containing secrets",
      "Bash(lsof:*) targeting PayPal/payment-related ports or production namespaces"
    ],
    "environment": [
      "RETIRE DE LA VERSION PUBLIEE : ce bloc decrit la machine et le projet client (chemins locaux, emplacement des fichiers de secrets, depot prive). Il est propre a chaque poste et se regenere localement ; il n'a pas sa place dans un depot public."
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/chef-hooks.sh ecriture",
            "timeout": 10,
            "statusMessage": "Garde-fou chef"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/chef-hooks.sh dispatch",
            "timeout": 10,
            "statusMessage": "Garde-fou chef"
          }
        ]
      },
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/chef-hooks.sh rondes",
            "timeout": 10,
            "statusMessage": "Garde-fou chef"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/chef-hooks.sh ecurie",
            "timeout": 60,
            "statusMessage": "Verification de l écurie",
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_ENTRYPOINT\" = sdk-cli ] || jq -r \".session_id // empty\" > \"$HOME/.claude/session-courante\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "find \"$HOME/.claude\" -maxdepth 1 -name \"chef-compteur-*.txt\" -mtime +7 -delete",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/claude-md-controle.sh",
            "timeout": 10,
            "statusMessage": "Contrôle du CLAUDE.md partagé"
          }
        ]
      }
    ]
  }
}
